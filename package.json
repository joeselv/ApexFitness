{
    "name": "apex-fitness-root",
    "private": true,
    "scripts": {
        "postinstall": "npm run install-all",
        "install-all": "cd shared && npm install && cd ../back && npm install && cd ../front && npm install",
        "dev": "concurrently \"npm run dev:back\" \"npm run dev:front\"",
        "dev:back": "cd back && npm run watch",
        "dev:front": "cd front && npm run dev"
    },
    "devDependencies": {
        "concurrently": "^8.2.0"
    }
}